{
  "expo": {
    "name": "ERA Fit",
    "slug": "era-fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-era.png",
    "scheme": "erafit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.erafit",
      "appleTeamId": "Z86PV9ZWWV",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground-era.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.erafit",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withRemoveAndroidSplashIcon",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow ERA to use your camera to capture progress photos.",
          "photosPermission": "Allow ERA to access your photo library to upload progress photos."
        }
      ],
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow ERA to use the microphone to dictate workout notes.",
          "speechRecognitionPermission": "Allow ERA to use speech recognition to convert your voice into text."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D4AF37",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
