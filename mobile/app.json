{
  "expo": {
    "name": "ERA Fit",
    "slug": "era-fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-era.png",
    "scheme": "erafit",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.erafit",
      "appleTeamId": "Z86PV9ZWWV",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow ERA to use speech recognition to convert your voice into text.",
        "NSMicrophoneUsageDescription": "Allow ERA to use the microphone to dictate workout notes."
      }
    },
    "android": {
      "icon": "./assets/images/icon-era.png",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon-era.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.erafit",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withRemoveAndroidSplashIcon",
      "./plugins/withPodfileFixes",
      "./plugins/withIosSceneLifecycle",
      "@react-native-firebase/app",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "era-x4",
          "project": "era-fit"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow ERA to use your camera to capture progress photos.",
          "photosPermission": "Allow ERA to access your photo library to upload progress photos."
        }
      ],
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow ERA to use the microphone to dictate workout notes.",
          "speechRecognitionPermission": "Allow ERA to use speech recognition to convert your voice into text."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D4AF37",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b5bb16f1-2c6c-45a7-93ee-48008b2beb50"
      }
    }
  }
}
